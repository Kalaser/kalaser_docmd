{
  "title": "我的文档",
  "url": "https://YOUR_USERNAME.github.io/YOUR_REPO",
  "src": "docs",
  "out": "site",
  "theme": {
    "name": "default"
  },
  "i18n": {
    "default": "zh",
    "locales": [
      { "id": "zh", "label": "中文" }
    ]
  },
  "plugins": {
    "seo": {
      "defaultDescription": "基于 docmd 构建的中文技术文档站。"
    }
  },
  "navigation": [
    {
      "title": "首页",
      "path": "/",
      "icon": "home"
    },
    {
      "title": "指南",
      "icon": "book",
      "collapsible": true,
      "children": [
        { "title": "快速开始", "path": "/guides/getting-started" },
        { "title": "写作规范", "path": "/guides/writing-docs" }
      ]
    },
    {
      "title": "教程",
      "icon": "code",
      "children": [
        { "title": "第一个文档", "path": "/tutorial/first-post" }
      ]
    },
    {
      "title": "参考",
      "icon": "settings",
      "children": [
        { "title": "配置参考", "path": "/reference/configuration" }
      ]
    },
    {
      "title": "笔记",
      "icon": "brain",
      "children": [
        { "title": "AI 学习笔记", "path": "/articles/ai-notes" }
      ]
    }
  ]
}
